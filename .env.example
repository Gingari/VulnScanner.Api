# Api Server Port example
API_PORT=8080

# Swagger UI on
ASPNETCORE_ENVIRONMENT=Development

# Scanning Settings example
Scanning__MaxParallelScans=2
Scanning__QueueCapacity=10

# Git Repos Settings example
Repositories__AllowedHosts__0=github.com
Repositories__AllowedHosts__1=gitlab.com
Repositories__AllowedHosts__2=bitbucket.org

# Мaximum time in seconds to wait for git clone operation to complete
Repositories__CloneTimeoutSeconds=120

# Version scanner examples
GITLEAKS_VERSION=8.30.1
TRIVY_VERSION=0.76.1